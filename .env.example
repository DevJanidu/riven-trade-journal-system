# Neon PostgreSQL connection string for the same project branch as storage.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Gold fundamental research. All server-only; never NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_GOLD_MODEL=gpt-6-luna
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Long random value used to sign login cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
APP_URL=http://localhost:3000

# Required: registration approval and password-reset OTP delivery through Resend.
RESEND_API_KEY=
APP_OWNER_EMAIL=janidudev@gmail.com
EMAIL_FROM=My Journal <noreply@journal.janidudev.com>

# Optional: owner account used by `npm run db:seed`.
SEED_USER_EMAIL=you@example.com

# Neon Object Storage S3 credentials for that branch. Keep these server-only.
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.REGION.aws.neon.tech
AWS_ACCESS_KEY_ID=REPLACE_WITH_NEON_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_NEON_SECRET_ACCESS_KEY
AWS_REGION=us-east-2
AWS_S3_BUCKET=trade-screenshots

# Upstash Redis REST credentials (server-only; never expose as NEXT_PUBLIC_*).
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_REST_TOKEN
