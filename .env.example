# Neon PostgreSQL connection string for the same project branch as storage.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Neon Object Storage S3 credentials for that branch. Keep these server-only.
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.REGION.aws.neon.tech
AWS_ACCESS_KEY_ID=REPLACE_WITH_NEON_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_NEON_SECRET_ACCESS_KEY
AWS_REGION=us-east-2
AWS_S3_BUCKET=trade-screenshots

# Upstash Redis REST credentials (server-only; never expose as NEXT_PUBLIC_*).
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_REST_TOKEN
